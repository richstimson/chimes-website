---
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import StoreBadges from '../components/home/StoreBadges.astro';
import data from '../data/roadmap-public.json';
import Layout from '../layouts/Layout.astro';

// The product roadmap. The content is generated in locapp-23
// (docs/features/roadmap.yaml -> roadmap-public.json); ./sync-roadmap.sh copies
// it here. Never edit the JSON: change the source in locapp-23. An item is
// "Shipped" only when its release is live on the App Store.

interface Theme { id: string; title: string; description: string }
interface Item { id: string; theme: string; title: string; benefit: string; audience: string; group: string }

const themes = data.themes as Theme[];
const items = data.items as Item[];

// Vendor items first in each theme, then both, then customer (owner, 2026-11-01).
const audienceOrder = ['vendor', 'both', 'customer'];
const byAudience = (a: Item, b: Item) => audienceOrder.indexOf(a.audience) - audienceOrder.indexOf(b.audience);

const groups = [
  { id: 'shipped', heading: 'Shipped', blurb: ['On the App Store and Play Store today.', 'Note: vendor features are currently iOS only.'] },
  { id: 'next', heading: 'Next', blurb: ['In progress, or planned next.'] },
  { id: 'later', heading: 'Later', blurb: ['Ideas we want to build. They may change.'] },
].map((g) => ({
  ...g,
  themes: themes
    .map((t) => ({ ...t, items: items.filter((i) => i.group === g.id && i.theme === t.id).sort(byAudience) }))
    .filter((t) => t.items.length),
}));

const who = (a: string) => (a === 'vendor' ? 'For vendors' : a === 'customer' ? 'For customers' : 'Customers and vendors');
---

<Layout
  title="Product roadmap - Chimes!"
  description="What Chimes does today, what we are building next, and what comes later: the ice cream app for customers and vendors."
>
  <!-- Look: docs/design/CHIMES_DESIGN.md. Audience tags use the colours of the 2026-11-01 roadmap preview. -->
  <style>
    .aud { display: inline-block; font-size: 0.8rem; font-weight: 700; padding: 2px 10px; border-radius: 999px; white-space: nowrap; vertical-align: 2px; }
    .aud-vendor { background: #fbe6ee; color: var(--color-raspberry-dark); }
    .aud-customer { background: #e6eefc; color: var(--color-logo-blue); }
    .aud-both { background: #efe6f6; color: #5b2a86; }
    .tab { color: var(--color-ink); }
    .tab[aria-selected='true'] { background: var(--color-ink); color: #fff; border-color: var(--color-ink); }
  </style>

  <div class="bg-hero">
    <Header />
    <div class="ch-container pt-8 sm:pt-12 pb-12 sm:pb-16 flex flex-col items-start gap-4">
      <h1 class="ch-h1 text-ink">Product roadmap</h1>
      <p class="max-w-2xl text-lg text-ink-muted">What Chimes does today, what we are building next, and what may come later.</p>
      <div class="flex flex-wrap gap-3" role="tablist" aria-label="Roadmap">
        {groups.map((g) => (
          <a href={`#${g.id}`} id={`tab-${g.id}`} role="tab" aria-controls={g.id} aria-selected={g.id === 'shipped' ? 'true' : 'false'} class="tab ch-btn ch-btn-secondary">{g.heading}</a>
        ))}
      </div>
    </div>
  </div>

  <main class="ch-container pb-12 sm:pb-20 text-ink">
    {groups.map((g) => (
      <section id={g.id} role="tabpanel" aria-labelledby={`tab-${g.id}`} class="roadmap-group pt-10">
        <h2 class="ch-h2">{g.heading}</h2>
        <div class="text-ink-muted mt-1 mb-6">{g.blurb.map((line) => <p>{line}</p>)}</div>
        {g.themes.map((t) => (
          <div class="ch-card ch-card-blue mb-5">
            <h3 class="text-xl font-bold">{t.title}</h3>
            <p class="text-ink-muted mb-4">{t.description}</p>
            <ul class="grid gap-x-8 gap-y-5 md:grid-cols-2">
              {t.items.map((i) => (
                <li class="border-l-4 border-ink/20 pl-4" data-roadmap-id={i.id}>
                  <p class={`aud aud-${i.audience} mb-1`}>{who(i.audience)}</p>
                  <p class="font-bold">{g.id === 'shipped' && <span aria-hidden="true">✓ </span>}{i.title}</p>
                  <p class="text-ink-muted">{i.benefit}</p>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </section>
    ))}

    <section class="pt-10">
      <p class="mb-2">Everything that is live is listed in detail on <a href="/features" class="underline">every feature</a>.</p>
      <p class="font-bold mb-4">Get Chimes. Vendor features are on iPhone.</p>
      <div class="flex flex-wrap items-center gap-4">
        <StoreBadges />
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<script>
  // Show one group at a time (owner, 2026-11-01: "the page is huge"). Without
  // JavaScript every group stays visible and the buttons are plain anchors.
  const ids = ['shipped', 'next', 'later'];
  const show = (id: string) => {
    for (const g of ids) {
      document.getElementById(g)!.hidden = g !== id;
      document.getElementById(`tab-${g}`)!.setAttribute('aria-selected', String(g === id));
    }
  };
  const fromHash = () => {
    const h = location.hash.slice(1);
    show(ids.includes(h) ? h : 'shipped');
  };
  for (const g of ids) {
    document.getElementById(`tab-${g}`)!.addEventListener('click', (e) => {
      e.preventDefault();
      history.replaceState(null, '', `#${g}`);
      show(g);
    });
  }
  window.addEventListener('hashchange', fromHash);
  fromHash();
</script>
