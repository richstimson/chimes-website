---
import ContactForm from '../components/ContactForm.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import HeroCluster from '../components/home/HeroCluster.astro';
import MapAlert from '../components/home/MapAlert.astro';
import Phone from '../components/home/Phone.astro';
import PicturePanel from '../components/home/PicturePanel.astro';
import ScreenCard from '../components/home/ScreenCard.astro';
import Sticker from '../components/home/Sticker.astro';
import Layout from '../layouts/Layout.astro';

// DRAFT of a new home page, direction A "Lock screen". Not linked anywhere and
// noindex; replaces / only on the owner's word. Positioning: locapp-23
// docs/marketing/website/positioning-brief.md (vendors first, benefits first,
// features as proof). Every claim must match a done + Public story in the feed
// (feed IDs in comments). Section ids keep the header's /#… links working once
// this becomes /.
//
// Look (2026-10-31, borrowed from founditfood.com.au as ideas, nothing copied):
// phones peek out of solid navy/pink panels instead of running full height, a
// tilted phone cluster with drawn stickers in the hero, a faint doodle tile
// behind white sections, Fredoka for headings, at most one playful line per
// section.

const vendorRows = [
  {
    // VRG-001, VRG-007, VMN-011, MAP-012
    badge: 'Free',
    title: 'Free to be found',
    line: 'A pin in your area with what you sell, your town and your links. Customers contact you directly.',
    img: '/images/app/20-register-business.webp',
    alt: 'Register your business: Free listing or Live van tracking',
    tone: 'navy',
    href: '/features/free-listing',
    more: 'About the free listing',
  },
  {
    // VLT-001, VLT-003, ALR-008, ALR-014
    badge: 'Your call',
    title: "You choose when you're seen",
    // Not "leaves the map": an Offline van can still show, faded, with an OFFLINE card (MAP-013).
    line: "Tap Stop Sharing and customers stop seeing where you are, and get no alerts about you. Other vans never see where you are.",
    img: '/images/app/22-location-sharing-offline-card.webp',
    card: true,
    alt: "Chimes Location Sharing: You're Offline, van not visible to your customers",
    tone: 'pink',
    href: '/features/live-van-tracking',
    more: 'About live van tracking',
  },
] as const;

// peek: which end of the screen carries the point (bottom sheets show the bottom).
const customerTiles = [
  {
    // ALR-001, ALR-003, ALR-006
    title: 'Pick your area',
    line: 'A postcode and a radius. A chime when a van comes in.',
    img: '/images/app/01-map-geofence.webp',
    alt: 'The Chimes map with a blue circle around the Isle of Wight',
    tone: 'navy',
    peek: 'top',
    show: 0.6,
    href: '/features/alerts',
  },
  {
    // FAV-001, FAV-009
    title: 'Keep your favourites',
    line: 'See which of your vans are out now.',
    img: '/images/app/17-favourites-list.webp',
    alt: 'The Chimes favourites list, with Gelato Dreams Live',
    tone: 'pink',
    peek: 'bottom',
    show: 0.6,
    href: '/features/favourites',
  },
  {
    // MAP-001, MAP-010, MAP-012
    title: 'Vans and shops nearby',
    line: 'Even ones not on Chimes yet.',
    // 16 (the Isle of Wight close-up) is the hero; this is the whole country.
    img: '/images/app/15-first-launch-map.webp',
    alt: 'The Chimes map of England with ice cream vans and shops grouped by area',
    tone: 'navy',
    peek: 'top',
    show: 0.6,
    href: '/features/map',
  },
] as const;

const appStore = {
  href: 'https://apps.apple.com/gb/app/chimes/id6738628000',
  src: 'https://tools.applemediaservices.com/api/badges/download-on-the-app-store/black/en-us?size=250x83&releaseDate=1735084800',
  alt: 'Download on the App Store',
};
const playStore = {
  href: 'https://play.google.com/store/apps/details?id=com.justiot.chimes',
  src: 'https://play.google.com/intl/en_us/badges/static/images/badges/en_badge_web_generic.png',
  alt: 'Get it on Google Play',
};
---

<Layout
  title="Chimes: the ice cream van on your phone"
  description="Chimes tells your customers when your ice cream van comes into their area. Free to get on the map. For customers: know when the van is in your area."
  noindex
>
  <Header />
  <main class="text-base-content">
    <!-- Hero: the vendor promise, shown from the customer's phone. ALR-006, ALR-009, VMN-011.
         Not a lock screen (owner, 2026-10-31): the map carries clusters, single
         vans and a favourite's card, with the alert floating over it. -->
    <section class="bg-[#0b1d3a] text-white overflow-hidden">
      <div class="container mx-auto max-w-6xl px-5 pt-12 sm:pt-20 grid lg:grid-cols-2 gap-10 items-end">
        <div class="text-center lg:text-left lg:pb-28">
          <!-- The brand line leads (owner, 2026-10-31); the vendor promise follows it. -->
          <h1 class="font-display text-5xl sm:text-7xl font-bold leading-[1.02] mb-5">The ice cream van on your phone.</h1>
          <p class="font-display text-2xl sm:text-3xl font-semibold text-[#ff5a8a] mb-3">Your customers hear you coming.</p>
          <p class="text-lg sm:text-xl text-slate-300 mb-8 max-w-md mx-auto lg:mx-0">
            Drive into their area and they get a chime with your name. You don't send a thing.
          </p>
          <div class="flex flex-wrap gap-3 justify-center lg:justify-start">
            <a href="#vendors" class="btn btn-lg border-0 bg-[#ff5a8a] hover:bg-[#ff3f77] text-white">Put my van on Chimes</a>
            <a href="#customers" class="btn btn-lg btn-outline text-white border-white/40 hover:bg-white/10 hover:border-white">Get the app</a>
          </div>
        </div>
        <!-- The map and alert in front of the van's Live card (MAP-003, MAP-011); the section's bottom edge cuts both phones. -->
        <HeroCluster>
          <Phone slot="back" src="/images/app/02-vendor-card.webp" alt="Michele's Ices on the Chimes map, marked Live" class="w-full" eager />
          <MapAlert slot="front" class="w-full" eager />
        </HeroCluster>
      </div>
    </section>

    <!-- How it works. Step 1 VLT-004, VBG-001; step 2 MAP-003, MAP-011; step 3 ALR-006, ALR-007, ALR-009, ALR-010 -->
    <section id="how-it-works" class="bg-doodle">
      <div class="container mx-auto max-w-6xl px-5 py-16 sm:py-24">
        <h2 class="font-display text-4xl sm:text-5xl font-bold text-center mb-3">Your van, on their phone.</h2>
        <p class="text-center text-lg text-base-content/70 mb-12 max-w-xl mx-auto">No posts, no messages to send. Customers pick their own area and Chimes tells them when you arrive.</p>
        <ol class="grid gap-12 md:grid-cols-3 md:gap-6">
          <li class="text-center flex flex-col">
            <span class="inline-flex self-center w-10 h-10 rounded-full bg-[#0b1d3a] text-white font-bold items-center justify-center mb-3">1</span>
            <h3 class="font-display text-2xl font-semibold">Tap Share Location</h3>
            <p class="text-base-content/70 mb-6">Then lock your phone and drive.</p>
            <PicturePanel tone="pink" from="bottom" class="mt-auto md:h-[330px]">
              <ScreenCard peek src="/images/app/21-location-sharing-live-card.webp" alt="Chimes Location Sharing: You're Live, with a Stop Sharing button" />
            </PicturePanel>
          </li>
          <li class="text-center flex flex-col">
            <span class="inline-flex self-center w-10 h-10 rounded-full bg-[#0b1d3a] text-white font-bold items-center justify-center mb-3">2</span>
            <h3 class="font-display text-2xl font-semibold">Customers see you coming</h3>
            <p class="text-base-content/70 mb-6">Your van moves on their map, marked Live.</p>
            <PicturePanel tone="navy" from="top" class="mt-auto md:h-[330px]">
              <Phone peek="bottom" show={0.54} src="/images/app/02-vendor-card.webp" alt="Michele's Ices on the Chimes map, Live, with Navigate, WhatsApp and Call buttons" class="w-60 md:w-64" />
            </PicturePanel>
          </li>
          <li class="text-center flex flex-col">
            <span class="inline-flex self-center w-10 h-10 rounded-full bg-[#ff5a8a] text-white font-bold items-center justify-center mb-3">3</span>
            <h3 class="font-display text-2xl font-semibold">They get a chime</h3>
            <p class="text-base-content/70 mb-6">Your name and what you sell, once per visit, app open or not.</p>
            <PicturePanel tone="pink" class="mt-auto flex-col gap-4 md:h-[330px]">
              <img src="/images/app/notification-ios.webp" alt="A Chimes alert on iPhone: Michele's Ices, The Best on the Island!" width="900" height="152" loading="lazy" class="w-full max-w-xs rounded-2xl shadow-lg -rotate-2" />
              <img src="/images/app/notification-android.webp" alt="A Chimes alert on Android" width="900" height="279" loading="lazy" class="w-full max-w-xs rounded-2xl shadow-lg rotate-1" />
              <p class="font-display text-xl text-white pt-2">The van's here. Your phone knew first.</p>
              <Sticker kind="note" class="-top-1 -right-1 rotate-12 scale-75" />
            </PicturePanel>
          </li>
        </ol>
      </div>
    </section>

    <!-- Vendors -->
    <section id="vendors" class="bg-[#fff7ec]">
      <div id="features" class="container mx-auto max-w-5xl px-5 py-16 sm:py-24">
        <p class="uppercase tracking-widest text-sm text-[#ff5a8a] font-semibold text-center mb-3">Your van, your rules</p>
        <h2 class="font-display text-4xl sm:text-5xl font-bold text-center mb-14">Built for the round</h2>
        <div class="space-y-16 sm:space-y-20">
          {vendorRows.map((r, i) => (
            <div class="grid md:grid-cols-2 gap-8 md:gap-12 items-center">
              <div class={`text-center md:text-left ${i % 2 ? 'md:order-2' : ''}`}>
                <span class="badge badge-lg border-0 bg-[#0b1d3a] text-white mb-3">{r.badge}</span>
                <h3 class="font-display text-3xl sm:text-4xl font-bold mb-3">{r.title}</h3>
                <p class="text-lg text-base-content/70 mb-4">{r.line}</p>
                <a href={r.href} class="font-semibold text-[#0b1d3a] underline decoration-[#ff5a8a] decoration-2 underline-offset-4 hover:text-[#ff5a8a]">{r.more} →</a>
              </div>
              <PicturePanel tone={r.tone} from="bottom">
                {'card' in r ? <ScreenCard peek src={r.img} alt={r.alt} /> : <Phone peek="top" show={0.56} src={r.img} alt={r.alt} class="w-60" />}
                {i === 0 && <Sticker kind="cone" class="top-4 right-4 rotate-12" />}
              </PicturePanel>
            </div>
          ))}
        </div>
      </div>

      <!-- Get started. VRG-001, VRG-002, VRG-008, VDM-001; vendor features are iPhone only -->
      <div id="pricing" class="container mx-auto max-w-3xl px-5 pb-20">
        <div class="rounded-3xl bg-[#0b1d3a] text-white p-8 sm:p-12 text-center">
          <h2 class="font-display text-4xl sm:text-5xl font-bold mb-6">Get your van on Chimes</h2>
          <ul class="text-left max-w-md mx-auto space-y-3 text-lg mb-8">
            <li class="flex gap-3"><span class="text-[#ff5a8a] font-bold">✓</span><span><strong>Free listing</strong>: your pin on the map, with what you sell.</span></li>
            <li class="flex gap-3"><span class="text-[#ff5a8a] font-bold">✓</span><span><strong>Live van tracking</strong>: start free in demo mode, updated about once an hour, on your own van and phone. The Chimes team then switches you to fully live.</span></li>
            <li class="flex gap-3"><span class="text-[#ff5a8a] font-bold">✓</span><span>Sign in with a code we email you. No password.</span></li>
          </ul>
          <p class="text-slate-300 mb-6">Get Chimes on your iPhone, then Settings → Register your business.</p>
          <div class="flex flex-wrap justify-center items-center gap-4">
            <a href={appStore.href} target="_blank" rel="noopener noreferrer" class="hover:scale-105 transition-transform">
              <img src={appStore.src} alt={appStore.alt} width="150" height="50" class="block h-[50px] w-auto" />
            </a>
            <a href="#contact" class="btn btn-outline text-white border-white/40 hover:bg-white/10 hover:border-white">Ask us a question</a>
          </div>
        </div>
      </div>
    </section>

    <!-- Customers. CUS-001, ONB-028 -->
    <section id="customers" class="bg-doodle">
     <div class="container mx-auto max-w-6xl px-5 py-16 sm:py-24">
      <p class="uppercase tracking-widest text-sm text-[#ff5a8a] font-semibold text-center mb-3">Looking for ice cream?</p>
      <h2 class="font-display text-4xl sm:text-5xl font-bold text-center mb-12">Know when the van's coming.</h2>
      <ul class="grid gap-12 sm:grid-cols-3 sm:gap-6">
        {customerTiles.map((t) => (
          <li class="text-center">
            <PicturePanel tone={t.tone} from={t.peek === 'top' ? 'bottom' : 'top'} class="mb-5">
              <Phone peek={t.peek} show={t.show} src={t.img} alt={t.alt} class="w-56 sm:w-48 lg:w-56" />
            </PicturePanel>
            <h3 class="font-display text-2xl font-semibold mb-1"><a href={t.href} class="hover:text-[#ff5a8a]">{t.title} →</a></h3>
            <p class="text-base-content/70">{t.line}</p>
          </li>
        ))}
      </ul>
      <div id="download" class="text-center mt-14">
        <p class="text-lg font-semibold mb-4">Free. No account. iPhone, iPad and Android.</p>
        <div class="flex flex-wrap justify-center items-center gap-4">
          <a href={appStore.href} target="_blank" rel="noopener noreferrer" class="hover:scale-105 transition-transform">
            <img src={appStore.src} alt={appStore.alt} width="150" height="50" class="block h-[50px] w-auto" />
          </a>
          <a href={playStore.href} target="_blank" rel="noopener noreferrer" class="hover:scale-105 transition-transform">
            <img src={playStore.src} alt={playStore.alt} width="191" height="74" class="block h-[74px] w-auto -my-3" />
          </a>
        </div>
      </div>
      <p class="text-center mt-10"><a href="/features" class="link link-primary">See every feature</a></p>
     </div>
    </section>

    <ContactForm />
  </main>
  <Footer />
</Layout>
