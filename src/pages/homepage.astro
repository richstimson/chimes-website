---
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Layout from '../layouts/Layout.astro';

// DRAFT of a new home page (owner, 2026-10-31: mostly pictures, little text,
// link off for detail). Not linked anywhere and noindex; replaces / only once
// the owner is happy. Hierarchy: locapp-23 docs/marketing/website/site-hierarchy.md.
// Every line here must match a public story in the feed (feed IDs in comments).

const customerTiles = [
  {
    // ALR-001, ALR-003
    title: 'Pick your area',
    line: 'A postcode and a radius.',
    img: '/images/app/01-map-geofence.webp',
    alt: 'The Chimes map with a blue circle around the Isle of Wight',
  },
  {
    // ALR-006, ALR-009, ALR-010
    title: 'Get a chime',
    line: 'When a van comes into your area, even with the app closed.',
    img: '/images/app/11-onboarding-notifications.webp',
    alt: "A Chimes alert: Michele's Ices, The Best on the Island!",
  },
  {
    // MAP-003, MAP-010, MAP-011, MAP-012
    title: "See who's out",
    line: 'Tap a van to see if it is Live, then message or find it.',
    img: '/images/app/02-vendor-card.webp',
    alt: "Michele's Ices on the map, Live, with Navigate, WhatsApp and Call buttons",
  },
  {
    // FAV-001, FAV-009
    title: 'Save favourites',
    line: 'Your vans, and which are out now.',
    img: '/images/app/17-favourites-list.webp',
    alt: 'The favourites list, with Gelato Dreams Live',
  },
];

const stores = [
  {
    href: 'https://apps.apple.com/gb/app/chimes/id6738628000',
    src: 'https://tools.applemediaservices.com/api/badges/download-on-the-app-store/black/en-us?size=250x83&releaseDate=1735084800',
    alt: 'Download on the App Store',
    cls: 'block h-[50px] w-auto',
    w: 150,
    h: 50,
  },
  {
    href: 'https://play.google.com/store/apps/details?id=com.justiot.chimes',
    src: 'https://play.google.com/intl/en_us/badges/static/images/badges/en_badge_web_generic.png',
    alt: 'Get it on Google Play',
    cls: 'block h-[74px] w-auto -my-3',
    w: 191,
    h: 74,
  },
];
---

<Layout
  title="Chimes! Know when the ice cream van is here"
  description="A chime on your phone when an ice cream van comes into your area. Vans and local businesses: get on the map for free."
  noindex
>
  <Header />
  <main class="text-base-content">
    <!-- Hero -->
    <section class="bg-base-200/60">
      <div class="container mx-auto max-w-6xl px-4 py-12 sm:py-20 grid lg:grid-cols-2 gap-10 items-center">
        <div class="text-center lg:text-left">
          <h1 class="text-4xl sm:text-6xl font-bold leading-tight mb-4">
            Know when the <span class="text-primary">ice cream van</span> is here.
          </h1>
          <!-- ALR-006 -->
          <p class="text-xl text-base-content/70 mb-8">A chime on your phone as a van comes into your area.</p>
          <div class="flex flex-wrap gap-3 justify-center lg:justify-start">
            <a href="#customers" class="btn btn-primary btn-lg">I want ice cream</a>
            <a href="#vendors" class="btn btn-secondary btn-lg">I run a van</a>
          </div>
        </div>
        <div class="flex justify-center gap-4">
          <img src="/images/app/02-vendor-card.webp" alt="Michele's Ices, Live on the Chimes map" width="600" height="1304" class="phone w-36 sm:w-56 -rotate-3 mt-10" />
          <img src="/images/app/11-onboarding-notifications.webp" alt="A Chimes alert as a van arrives" width="600" height="1304" class="phone w-36 sm:w-56 rotate-3" />
        </div>
      </div>
    </section>

    <!-- Customers -->
    <section id="customers" class="container mx-auto max-w-6xl px-4 py-16">
      <h2 class="text-3xl sm:text-4xl font-bold text-center mb-12">Never miss the van</h2>
      <ul class="grid gap-x-4 gap-y-10 grid-cols-2 lg:grid-cols-4">
        {customerTiles.map((t) => (
          <li class="text-center">
            <img src={t.img} alt={t.alt} width="600" height="1304" loading="lazy" class="phone w-full max-w-48 mx-auto mb-5" />
            <h3 class="text-xl font-semibold mb-1">{t.title}</h3>
            <p class="text-base-content/70">{t.line}</p>
          </li>
        ))}
      </ul>
      <!-- ONB-028, CUS-001 -->
      <p class="text-center text-base-content/70 mt-12 mb-4">iPhone, iPad and Android. No account needed.</p>
      <div class="flex flex-wrap justify-center items-center gap-4">
        {stores.map((s) => (
          <a href={s.href} target="_blank" rel="noopener noreferrer" class="hover:scale-105 transition-transform">
            <img src={s.src} alt={s.alt} width={s.w} height={s.h} class={s.cls} />
          </a>
        ))}
      </div>
      <p class="text-center mt-6"><a href="/features#customers" class="link link-primary">More for customers</a></p>
    </section>

    <!-- Vendors -->
    <section id="vendors" class="bg-base-200/60">
      <div class="container mx-auto max-w-6xl px-4 py-16 grid lg:grid-cols-2 gap-10 items-center">
        <div class="flex justify-center order-2 lg:order-1">
          <img src="/images/app/04-vendor-map.webp" alt="A vendor's own van on the Chimes map" width="600" height="1304" loading="lazy" class="phone w-56" />
        </div>
        <div class="order-1 lg:order-2">
          <h2 class="text-3xl sm:text-4xl font-bold mb-8 text-center lg:text-left">Run a van? Get on the map.</h2>
          <div class="grid gap-4 sm:grid-cols-2">
            <!-- VRG-001 -->
            <div class="card bg-base-100 border border-base-300">
              <div class="card-body p-5">
                <span class="badge badge-success badge-outline">FREE</span>
                <h3 class="text-xl font-semibold">Free listing</h3>
                <p class="text-base-content/70">A pin in your area, all year round.</p>
              </div>
            </div>
            <!-- VRG-002, MAP-003, ALR-006 -->
            <div class="card bg-base-100 border border-base-300">
              <div class="card-body p-5">
                <span class="badge badge-info badge-outline">FREE TRIAL</span>
                <h3 class="text-xl font-semibold">Live van tracking</h3>
                <p class="text-base-content/70">Customers see your van move and get a chime as you arrive.</p>
              </div>
            </div>
          </div>
          <!-- VRG-001, VRG-012 AC1; vendor features are iPhone only -->
          <p class="text-base-content/70 mt-6 text-center lg:text-left">
            In Chimes on your iPhone: Settings, then Register your business.
          </p>
          <p class="mt-4 text-center lg:text-left"><a href="/features#vendors" class="link link-primary">More for vendors</a></p>
        </div>
      </div>
    </section>

    <p class="text-center py-10"><a href="/features" class="link">See every feature</a></p>
  </main>
  <Footer />
</Layout>

<style>
  .phone {
    height: auto;
    border-radius: 1.75rem;
    border: 6px solid #1f2937;
    box-shadow: 0 12px 30px rgb(0 0 0 / 0.18);
  }
</style>
