---
import ContactForm from '../components/ContactForm.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import HeroCluster from '../components/home/HeroCluster.astro';
import MapAlert from '../components/home/MapAlert.astro';
import Phone from '../components/home/Phone.astro';
import PicturePanel from '../components/home/PicturePanel.astro';
import ScreenCard from '../components/home/ScreenCard.astro';
import StoreBadges from '../components/home/StoreBadges.astro';
import Layout from '../layouts/Layout.astro';

// DRAFT of a new home page. Not linked anywhere and noindex; replaces / only on
// the owner's word. Positioning: locapp-23 docs/marketing/website/positioning-brief.md
// (vendors first, benefits first, features as proof). Every claim must match a
// done + Public story in the feed (feed IDs in comments). Section ids keep the
// header's /#… links working once this becomes /.
//
// Look: the "Pink Gradient" design pack, docs/design/CHIMES_DESIGN.md. Order
// (§6): hero on the sundae gradient, how it works on white, the vendor band,
// the customer section on the lilac wash, footer. Raspberry buttons are for
// vans, blue for customers; one filled raspberry button per screen-height.

// The vendor band's ticks, each linking to its key-feature page.
const vendorTicks = [
  // VRG-001, VRG-007, VMN-011, MAP-012
  { term: 'Free listing', text: 'your pin on the map, with what you sell.', href: '/features/free-listing' },
  // VDM-001, VDM-005, MAP-003 (every live-tracking vendor starts in demo mode)
  { term: 'Live van tracking', text: 'start free in demo mode, then the Chimes team switches you to fully live. Customers follow your van, marked Live.', href: '/features/live-van-tracking' },
  // VLT-003, ALR-008, ALR-014. Not "leaves the map": an Offline van can still show, faded (MAP-013).
  { term: 'Your call', text: 'tap Stop Sharing and customers stop seeing where you are. Other vans never see you.', href: '/features/live-van-tracking' },
];

// peek: which end of the screen carries the point (bottom sheets show the bottom).
const customerCards = [
  {
    // ALR-001, ALR-003, ALR-006
    title: 'Pick your area',
    line: 'A postcode and a radius. A chime when a van comes in.',
    img: '/images/app/01-map-geofence.webp',
    alt: 'The Chimes map with a blue circle around the Isle of Wight',
    peek: 'top',
    href: '/features/alerts',
  },
  {
    // FAV-001, FAV-009
    title: 'Keep your favourites',
    line: 'See which of your vans are out now.',
    img: '/images/app/17-favourites-list.webp',
    alt: 'The Chimes favourites list, with Gelato Dreams Live',
    peek: 'bottom',
    href: '/features/favourites',
  },
  {
    // MAP-001, MAP-010, MAP-012
    title: 'Vans and shops nearby',
    line: 'Even ones not on Chimes yet.',
    // 16 (the Isle of Wight close-up) is the hero; this is the whole country.
    img: '/images/app/15-first-launch-map.webp',
    alt: 'The Chimes map of England with ice cream vans and shops grouped by area',
    peek: 'top',
    href: '/features/map',
  },
] as const;

const appStoreHref = 'https://apps.apple.com/gb/app/chimes/id6738628000';
---

<Layout
  title="Chimes - the ice cream app"
  description="Chimes tells your customers when your ice cream van comes into their area. Free to get on the map. For customers: know when the van is in your area."
  noindex
>
  <!-- Header and hero share the sundae gradient. ALR-006, ALR-009, VMN-011. -->
  <div class="bg-hero">
    <Header />
    <section class="ch-container grid lg:grid-cols-2 gap-12 items-center pt-8 sm:pt-12 pb-14 sm:pb-24">
      <div class="flex flex-col items-start gap-5">
        <span class="ch-eyebrow-pill">For ice cream vans</span>
        <h1 class="ch-h1 text-ink"><span class="text-logo-blue">Chimes</span> - the ice cream app</h1>
        <p class="text-[22px] leading-snug font-bold text-raspberry-dark">Your customers know you're on the way.</p>
        <p class="text-lg leading-[1.55] text-ink-muted-pink max-w-[520px]">
          Drive into their area and they get a chime with your name. You don't send a thing.
        </p>
        <div class="flex flex-wrap gap-3">
          <a href="#vendors" class="ch-btn ch-btn-vendor">Put my van on the map</a>
          <a href="#how-it-works" class="ch-btn ch-btn-secondary">See how it works</a>
        </div>
        <!-- Register your interest: email only, to send-vendor-interest.php, which
             mails the team and sends the vendor a welcome email. Outline button:
             one filled raspberry button per screen-height. -->
        <form id="interestForm" action="/send-vendor-interest.php" method="post" class="w-full max-w-[520px] flex flex-col gap-2 pt-2" novalidate>
          <label for="interestEmail" class="text-[15px] font-bold text-ink">Not ready yet? Leave your email and we'll tell you more.</label>
          <div class="flex flex-col sm:flex-row gap-3">
            <input id="interestEmail" name="email" type="email" autocomplete="email" placeholder="name@example.com" class="input flex-1 min-h-[52px] text-base" required />
            <button type="submit" id="interestSubmit" class="ch-btn ch-btn-secondary">Register your interest</button>
          </div>
          <label class="ch-hp" aria-hidden="true">Leave this empty <input name="nickname" type="text" tabindex="-1" autocomplete="off" /></label>
          <p id="interestMessage" role="status" aria-live="polite" class="text-[15px] hidden"></p>
        </form>
      </div>
      <!-- The map and alert in front of the van's Live card (MAP-003, MAP-011). Not a lock screen (owner, 2026-10-31). -->
      <HeroCluster>
        <Phone slot="back" src="/images/app/02-vendor-card.webp" alt="Michele's Ices on the Chimes map, marked Live" class="w-full" eager />
        <MapAlert slot="front" class="w-full" eager />
      </HeroCluster>
    </section>
  </div>

  <main class="text-ink">
    <!-- How it works. Step 1 VLT-004, VBG-001; step 2 MAP-003, MAP-011; step 3 ALR-006, ALR-007, ALR-009, ALR-010 -->
    <section id="how-it-works" class="ch-container pt-10 pb-12 sm:pb-20">
      <div class="max-w-[640px] mb-8 flex flex-col gap-2.5">
        <h2 class="ch-h2">Your van, on their phone.</h2>
        <p class="text-lg leading-[1.55] text-ink-muted">No posts, no messages to send. Customers pick their own area and Chimes tells them when you arrive.</p>
      </div>
      <ol class="grid gap-5 md:grid-cols-3">
        <li class="ch-card ch-card-pink flex flex-col gap-3">
          <span class="ch-step-badge">1</span>
          <h3 class="text-xl font-bold">Tap Share Location</h3>
          <p class="text-ink-muted">Then lock your phone and drive.</p>
          <PicturePanel from="bottom" class="mt-auto h-[260px]">
            <ScreenCard peek src="/images/app/21-location-sharing-live-card.webp" alt="Chimes Location Sharing: You're Live, with a Stop Sharing button" />
          </PicturePanel>
        </li>
        <li class="ch-card ch-card-lilac flex flex-col gap-3">
          <span class="ch-step-badge">2</span>
          <h3 class="text-xl font-bold">Customers see you coming</h3>
          <p class="text-ink-muted">Your van moves on their map, marked Live.</p>
          <PicturePanel from="top" class="mt-auto h-[260px]">
            <Phone peek="bottom" show={0.5} src="/images/app/02-vendor-card.webp" alt="Michele's Ices on the Chimes map, Live, with Navigate, WhatsApp and Call buttons" class="w-52" />
          </PicturePanel>
        </li>
        <li class="ch-card ch-card-blue flex flex-col gap-3">
          <span class="ch-step-badge">3</span>
          <h3 class="text-xl font-bold">They get a chime</h3>
          <p class="text-ink-muted">Your name and what you sell, once per visit, app open or not.</p>
          <PicturePanel class="mt-auto h-[260px] flex-col gap-3">
            <img src="/images/app/notification-ios.webp" alt="A Chimes alert on iPhone: Michele's Ices, The Best on the Island!" width="900" height="152" loading="lazy" class="w-full max-w-xs rounded-2xl shadow-md -rotate-2" />
            <img src="/images/app/notification-android.webp" alt="A Chimes alert on Android" width="900" height="279" loading="lazy" class="w-full max-w-xs rounded-2xl shadow-md rotate-1" />
            <p class="font-display text-lg font-semibold text-ink pt-1">The van's here. Your phone knew first.</p>
          </PicturePanel>
        </li>
      </ol>
    </section>

    <!-- Vendor band. VRG-001, VRG-002, VRG-008, VDM-001; vendor features are iPhone only. -->
    <section id="vendors" class="ch-container pb-12 sm:pb-20">
      <div id="features" class="ch-on-night bg-vendor-band rounded-panel px-6 py-10 sm:px-12 sm:py-14 grid gap-10 lg:grid-cols-2 items-center">
        <div id="pricing" class="flex flex-col gap-4">
          <h2 class="ch-h2 text-white">Get your van on Chimes</h2>
          <p class="text-[17px] text-on-night">Tell us about your business and we'll set you up within 24 hours.</p>
          <p class="text-[17px] text-on-night">Or do it yourself: get Chimes on your <a href={appStoreHref} target="_blank" rel="noopener noreferrer" class="underline decoration-candy decoration-2 underline-offset-4 hover:decoration-white">iPhone</a>, then Settings → Register your business. You sign in with a code we email you.</p>
          <div class="flex flex-wrap gap-3 pt-2">
            <a href="/register" class="ch-btn ch-btn-vendor">Register your business</a>
            <a href="#contact" class="ch-btn ch-btn-ghost-light">Ask us a question</a>
          </div>
        </div>
        <ul class="flex flex-col gap-4 text-[17px] text-white">
          {vendorTicks.map((t) => (
            <li class="flex gap-3.5">
              <svg class="shrink-0 w-5 h-5 mt-1 text-candy" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg>
              <span><a href={t.href} class="font-bold underline decoration-candy decoration-2 underline-offset-4 hover:decoration-white">{t.term}</a>: <span class="text-on-night">{t.text}</span></span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Customers. CUS-001, ONB-028 -->
    <section id="customers" class="bg-customer ch-section">
      <div class="ch-container">
        <div class="max-w-[640px] mb-8 flex flex-col gap-2.5">
          <span class="ch-eyebrow-blue">Looking for ice cream?</span>
          <h2 class="ch-h2">Know when the van's coming.</h2>
          <p class="text-lg leading-[1.55] text-ink-muted-blue">Free. No account. iPhone, iPad and Android.</p>
        </div>
        <ul class="grid gap-5 md:grid-cols-3 mb-8">
          {customerCards.map((c) => (
            <li class="ch-card flex flex-col gap-3">
              <h3 class="text-xl font-bold"><a href={c.href} class="hover:text-logo-blue">{c.title}</a></h3>
              <p class="text-ink-muted-blue">{c.line}</p>
              <PicturePanel tone="blue" from={c.peek === 'top' ? 'bottom' : 'top'} class="mt-auto h-[260px]">
                <Phone peek={c.peek} show={0.5} src={c.img} alt={c.alt} class="w-52" />
              </PicturePanel>
            </li>
          ))}
        </ul>
        <div id="download" class="flex flex-wrap items-center gap-4">
          <StoreBadges />
          <a href="/features" class="ch-btn ch-btn-secondary-blue">See every feature</a>
        </div>
      </div>
    </section>

    <ContactForm />
  </main>
  <Footer />
</Layout>

<style>
  .ch-hp { position: absolute; left: -10000px; width: 1px; height: 1px; overflow: hidden; }
</style>

<script>
  const interestForm = document.getElementById('interestForm') as HTMLFormElement | null;
  const interestBtn = document.getElementById('interestSubmit') as HTMLButtonElement | null;
  const interestMsg = document.getElementById('interestMessage') as HTMLParagraphElement | null;
  const interestEmail = document.getElementById('interestEmail') as HTMLInputElement | null;

  function showInterest(ok: boolean, text: string) {
    if (!interestMsg) return;
    interestMsg.className = `text-[15px] font-bold ${ok ? 'text-ink' : 'text-raspberry-dark'}`;
    interestMsg.textContent = text;
  }

  if (interestForm && interestBtn && interestEmail) {
    interestForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!interestEmail.value.trim() || !interestEmail.checkValidity()) {
        showInterest(false, 'Please enter a valid email address.');
        interestEmail.focus();
        return;
      }
      interestBtn.disabled = true;
      interestBtn.textContent = 'Sending…';
      // Local dev servers have no PHP (as in ContactForm.astro).
      const isProduction = location.hostname !== 'localhost' && location.hostname !== '127.0.0.1' && !location.port;
      try {
        if (!isProduction) {
          await new Promise((r) => setTimeout(r, 600));
          showInterest(true, 'Development mode: received, nothing sent.');
        } else {
          const response = await fetch('/send-vendor-interest.php', { method: 'POST', body: new FormData(interestForm) });
          const result = await response.json();
          if (result.success) {
            showInterest(true, "Thanks! We've emailed you more about Chimes. If it isn't there, check your spam folder.");
            interestForm.reset();
          } else {
            showInterest(false, result.message || 'Something went wrong. Please try again.');
          }
        }
      } catch {
        showInterest(false, 'Something went wrong. Please try again, or email chimesapp@just-iot.com.');
      } finally {
        interestBtn.disabled = false;
        interestBtn.textContent = 'Register your interest';
      }
    });
  }
</script>
