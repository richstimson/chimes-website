---
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Layout from '../layouts/Layout.astro';
import data from '../data/public-features.json';

// Generated list, copied by ./sync-features.sh. Never edit the JSON here.
// Every copy marked PLACEHOLDER below is draft text awaiting the owner.

interface Feature {
  id: string;
  area: string;
  title: string;
  benefit: string;
  actor: string;
  platform: string;
}

const features = data.features as Feature[];

// Group by area, keeping source order.
const byArea = new Map<string, Feature[]>();
for (const f of features) {
  if (!byArea.has(f.area)) byArea.set(f.area, []);
  byArea.get(f.area)!.push(f);
}
const areas = [...byArea.entries()].map(([name, items]) => ({ name, items }));

// Vendors are the paying audience: any area holding a vendor entry goes first.
const vendorAreas = areas.filter((a) => a.items.some((f) => f.actor === 'vendor'));
const customerAreas = areas.filter((a) => !a.items.some((f) => f.actor === 'vendor'));

const platformNote = (p: string) =>
  p === 'ios' ? 'iPhone' : p === 'both' ? 'iPhone and Android' : p === 'android' ? 'Android' : '';

const sections = [
  {
    key: 'vendors',
    heading: 'For ice cream vans and mobile vendors',
    intro: 'PLACEHOLDER: vendor section intro. Say who this is for and what a vendor gets.',
    areas: vendorAreas,
  },
  {
    key: 'customers',
    heading: 'For customers',
    intro: 'PLACEHOLDER: customer section intro. Say what customers get.',
    areas: customerAreas,
  },
];
---

<Layout
  title="PLACEHOLDER page title - Chimes!"
  description="PLACEHOLDER meta description for the Chimes! features page."
>
  <Header />
  <main class="container mx-auto max-w-5xl px-4 py-8 sm:py-12 text-base-content">
    <h1 class="text-4xl font-bold mb-3">PLACEHOLDER hero headline</h1>
    <p class="text-lg text-base-content/70 mb-12">
      PLACEHOLDER hero intro: one or two sentences on what Chimes! does.
    </p>

    {sections.map((s) => (
      <section id={s.key} class="mb-16">
        <h2 class="text-3xl font-bold mb-2">{s.heading}</h2>
        <p class="text-base-content/70 mb-8">{s.intro}</p>
        {s.areas.map((area) => (
          <div class="mb-10">
            <h3 class="text-xl font-semibold mb-4">{area.name}</h3>
            <ul class="grid gap-4 md:grid-cols-2">
              {area.items.map((f) => (
                <li class="card bg-base-100 shadow-sm border border-base-200">
                  <div class="card-body p-5">
                    <h4 class="font-semibold">{f.title}</h4>
                    <p class="text-base-content/80">{f.benefit}</p>
                    {platformNote(f.platform) && (
                      <p class="text-sm text-base-content/60">{platformNote(f.platform)}</p>
                    )}
                  </div>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </section>
    ))}

    <section id="get-chimes" class="text-center py-10">
      <h2 class="text-3xl font-bold mb-3">PLACEHOLDER closing call to action</h2>
      <p class="text-base-content/70 mb-6">PLACEHOLDER closing line inviting people to download Chimes!.</p>
      <div class="flex flex-wrap justify-center items-center gap-4">
        <a href="https://apps.apple.com/gb/app/chimes/id6738628000" target="_blank" rel="noopener noreferrer" class="hover:scale-105 transition-transform">
          <img
            src="https://tools.applemediaservices.com/api/badges/download-on-the-app-store/black/en-us?size=250x83&releaseDate=1735084800"
            alt="Download on the App Store"
            width="150" height="50"
            class="block h-[50px] w-auto"
          />
        </a>
        <a href="https://play.google.com/store/apps/details?id=com.justiot.chimes" target="_blank" rel="noopener noreferrer" class="hover:scale-105 transition-transform">
          <img
            src="https://play.google.com/intl/en_us/badges/static/images/badges/en_badge_web_generic.png"
            alt="Get it on Google Play"
            width="191" height="74"
            class="block h-[74px] w-auto -my-3"
          />
        </a>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
