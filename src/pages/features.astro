---
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import StoreBadges from '../components/home/StoreBadges.astro';
import { featurePages } from '../data/feature-pages';
import data from '../data/public-features.json';
import Layout from '../layouts/Layout.astro';

// Level 3 of the site hierarchy (locapp-23 docs/marketing/website/site-hierarchy.md):
// every public story, its feed title and benefit line, and no prose. The prose
// moved, shortened, to the key-feature pages (/features/<slug>,
// src/data/feature-pages.ts). The list is generated: ./sync-features.sh copies
// public-features.json; never edit the JSON here.

interface Feature {
  id: string;
  title: string;
  benefit: string;
  actor: string;
  platform: string;
}

const features = data.features as Feature[];
const audienceOf = (f: Feature) => (f.actor === 'customer' ? 'customers' : 'vendors');

// Each story is listed once, under the key-feature page that cites it for its
// own audience (ALR-008 is on both Alerts and Live van tracking; a customer
// reads it under Alerts). Stories no page cites go to "More", so a sync never
// drops one.
const homeOf = (f: Feature) => {
  const pages = featurePages.filter((p) => p.ids.includes(f.id));
  return pages.find((p) => p.audience === audienceOf(f)) ?? pages[0];
};

// The feed says only "ios"; vendor features are on iPhone.
const platformNote = (p: string) => (p === 'ios' ? 'iPhone' : p === 'android' ? 'Android' : '');

const sections = (['vendors', 'customers'] as const).map((audience) => {
  const mine = features.filter((f) => audienceOf(f) === audience);
  const groups = featurePages
    .filter((p) => p.audience === audience)
    .map((p) => ({ heading: p.name, href: `/features/${p.slug}`, items: mine.filter((f) => homeOf(f) === p) }));
  // Not "no page at all": a story whose only page is the other audience's
  // would otherwise be listed nowhere.
  const rest = mine.filter((f) => !groups.some((g) => g.items.includes(f)));
  if (rest.length) groups.push({ heading: 'More', href: '', items: rest });
  return {
    audience,
    heading: audience === 'vendors' ? 'For ice cream vans' : 'For customers',
    groups: groups.filter((g) => g.items.length),
  };
});
---

<Layout
  title="Every feature - Chimes!"
  description="Every Chimes feature in one list: for ice cream vans and mobile vendors on iPhone, and for customers on iPhone, iPad and Android."
>
  <Header />
  <main class="container mx-auto max-w-5xl px-5 py-10 sm:py-14 text-base-content">
    <h1 class="font-display text-4xl sm:text-5xl font-bold mb-3">Every feature</h1>
    <p class="text-base-content/70 mb-10">
      <a href="#vendors" class="link">For ice cream vans</a> · <a href="#customers" class="link">For customers</a>
    </p>

    {sections.map((s) => (
      <section id={s.audience} class="mb-14">
        <h2 class="font-display text-3xl font-bold mb-6">{s.heading}</h2>
        {s.groups.map((g) => (
          <div class="mb-10">
            <h3 class="text-xl font-semibold mb-3">
              {g.href ? <a href={g.href} class="hover:text-[#ff5a8a]">{g.heading} →</a> : g.heading}
            </h3>
            <ul class="grid gap-x-8 gap-y-4 md:grid-cols-2">
              {g.items.map((f) => (
                <li class="border-l-4 border-[#ff5a8a]/60 pl-4" data-feature-id={f.id}>
                  <p class="font-semibold">{f.title}</p>
                  <p class="text-base-content/75">{f.benefit}</p>
                  {platformNote(f.platform) && <p class="text-sm text-base-content/55">{platformNote(f.platform)}</p>}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </section>
    ))}

    <section id="get-chimes" class="text-center py-8">
      <p class="font-semibold mb-4">Get Chimes. Vendor features are on iPhone.</p>
      <div class="flex flex-wrap justify-center items-center gap-4">
        <StoreBadges />
      </div>
    </section>
  </main>
  <Footer />
</Layout>
