---
// Site header (docs/design/CHIMES_DESIGN.md §5–6): cone logo and wordmark,
// links in ink, and one customer button ("Get the app", action blue). It has
// no background of its own, so on a page that wraps it in bg-hero it sits on
// the hero gradient; elsewhere it sits on white. Facebook and Instagram are in
// the footer and the contact section. Below lg the links fold into a menu.
// `home` is the page that holds the #… sections: the draft /homepage passes
// its own path so its links stay on it; drop that once it becomes / (D2).
const { home = '/' } = Astro.props as { home?: string };
const links = [
  { href: `${home}#features`, label: 'Features' },
  { href: `${home}#how-it-works`, label: 'How it works' },
  { href: `${home}#pricing`, label: 'Pricing' },
  { href: '/blog/', label: 'Blog' },
  { href: `${home}#contact`, label: 'Contact' },
];
---

<header class="relative z-20">
  <div class="ch-container flex items-center justify-between gap-4 py-4">
    <a href="/" class="flex items-center gap-2 shrink-0 rounded-xl focus-visible:outline-3 focus-visible:outline-action-blue focus-visible:outline-offset-2" aria-label="Chimes home">
      <img src="/images/chimes-logo-192.webp" alt="" width="192" height="192" class="h-11 w-11 sm:h-12 sm:w-12" />
      <span class="ch-word text-[28px] leading-none">Chimes</span>
    </a>

    <nav aria-label="Main" class="hidden lg:flex items-center gap-6 text-[15px] font-medium text-ink">
      {links.map((l) => (
        <a href={l.href} class="hover:text-logo-blue rounded focus-visible:outline-3 focus-visible:outline-action-blue focus-visible:outline-offset-2">{l.label}</a>
      ))}
      <a href={`${home}#download`} class="ch-btn ch-btn-nav ch-btn-customer">Get the app</a>
    </nav>

    <div class="flex items-center gap-2 lg:hidden">
      <a href={`${home}#download`} class="ch-btn ch-btn-nav ch-btn-customer">Get the app</a>
      <details class="dropdown dropdown-end">
        <summary class="list-none grid place-items-center w-11 h-11 rounded-xl bg-white/70 text-ink cursor-pointer focus-visible:outline-3 focus-visible:outline-action-blue" aria-label="Menu">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </summary>
        <ul class="dropdown-content menu bg-white rounded-card z-30 mt-2 w-56 p-2 shadow-lg ring-1 ring-sky-tint-100 text-[15px] font-medium text-ink">
          {links.map((l) => (
            <li><a href={l.href} class="min-h-11">{l.label}</a></li>
          ))}
        </ul>
      </details>
    </div>
  </div>
</header>
