---
// Two overlapping, tilted pictures for a navy hero, with three drawn stickers.
// Put it last in the hero and give the hero overflow-hidden with no bottom
// padding: the section's bottom edge cuts both pictures. Slot "front" takes
// the point (keep it in the top two thirds of the screen); "back" is context.
import Sticker from './Sticker.astro';

interface Props {
  class?: string;
}
const { class: cls = '' } = Astro.props;
---

<div class:list={['relative mx-auto w-full max-w-[440px] lg:max-w-[500px] h-[400px] sm:h-[520px] lg:h-[600px]', cls]}>
  <div class="absolute right-[2%] top-0 w-[54%] rotate-6">
    <slot name="back" />
  </div>
  <div class="absolute left-[3%] top-[11%] w-[62%] -rotate-[4deg]">
    <slot name="front" />
  </div>
  <Sticker kind="cone" class="top-[3%] left-[6%] -rotate-12" />
  <Sticker kind="note" class="top-[34%] right-[0%] rotate-12" />
  <Sticker kind="lolly" class="bottom-[8%] right-[6%] rotate-[18deg]" />
</div>
