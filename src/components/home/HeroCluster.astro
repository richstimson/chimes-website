---
// Two overlapping, tilted pictures in the hero's screenshot frame (radius 28,
// docs/design/CHIMES_DESIGN.md §5). The frame's bottom edge cuts both
// pictures. Slot "front" takes the point (keep it in the top two thirds of the
// screen); "back" is context.
interface Props {
  class?: string;
}
const { class: cls = '' } = Astro.props;
---

<div class:list={['relative mx-auto w-full max-w-[460px] lg:max-w-[520px] h-[400px] sm:h-[500px] lg:h-[560px] overflow-hidden rounded-panel bg-white/60 ring-1 ring-white', cls]}>
  <div class="absolute right-[4%] top-[6%] w-[52%] rotate-6">
    <slot name="back" />
  </div>
  <div class="absolute left-[11%] top-[14%] w-[58%] -rotate-[4deg]">
    <slot name="front" />
  </div>
</div>
