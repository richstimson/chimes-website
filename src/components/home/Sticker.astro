---
// A small round "sticker" that floats over a picture: a cone, an ice lolly or a
// pair of notes (the chime). Original drawings. Decorative only; position it
// with absolute-positioning classes in `class`.
interface Props {
  kind: 'cone' | 'lolly' | 'note';
  class?: string;
}
const { kind, class: cls = '' } = Astro.props;
---

<span aria-hidden="true" class:list={['sticker absolute z-10 grid place-items-center rounded-full bg-white', cls]}>
  <svg viewBox="0 0 64 64" class="w-[72%] h-[72%]">
    {kind === 'cone' && (
      <g>
        <path d="M22 30 L32 57 L42 30 Z" fill="#f4b860" stroke="#c98a3a" stroke-width="1.5" stroke-linejoin="round" />
        <path d="M26 34 L34 42 M31 31 L37.5 37.5 M38 34 L30 42 M33 31 L26.5 37.5" stroke="#c98a3a" stroke-width="1.5" stroke-linecap="round" />
        <circle cx="32" cy="23" r="11" fill="#ff5a8a" />
        <path d="M21.5 26 q2 6 4.5 1 q2.5 5 5 0 q2.5 5 5 0 q2.5 5 5.5-1" fill="#ff5a8a" />
        <circle cx="28" cy="19" r="3" fill="#fff" opacity="0.55" />
        <circle cx="33" cy="11" r="3.2" fill="#dc2626" />
      </g>
    )}
    {kind === 'lolly' && (
      <g>
        <rect x="29" y="40" width="6" height="17" rx="3" fill="#e2b77a" />
        <rect x="20" y="9" width="24" height="35" rx="12" fill="#fb923c" />
        <rect x="20" y="24" width="24" height="8" fill="#fde68a" />
        <rect x="25" y="14" width="4" height="8" rx="2" fill="#fff" opacity="0.55" />
      </g>
    )}
    {kind === 'note' && (
      <g fill="#0b1d3a">
        <ellipse cx="22" cy="45" rx="6.5" ry="4.8" transform="rotate(-20 22 45)" />
        <ellipse cx="41" cy="40" rx="6.5" ry="4.8" transform="rotate(-20 41 40)" />
        <rect x="26.3" y="19" width="2.6" height="25" />
        <rect x="45.3" y="14" width="2.6" height="25" />
        <path d="M26.3 18 L47.9 13 L47.9 19.5 L26.3 24.5 Z" />
      </g>
    )}
  </svg>
</span>

<style>
  .sticker {
    width: 3.5rem;
    height: 3.5rem;
    box-shadow: 0 8px 20px rgb(15 23 42 / 0.22);
  }
  @media (min-width: 640px) {
    .sticker {
      width: 4.25rem;
      height: 4.25rem;
    }
  }
</style>
