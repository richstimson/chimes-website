---
// Site footer (docs/design/CHIMES_DESIGN.md §6): night #0B1D3A, text #D6DEF0,
// wordmark white.
const home = '/';
const product = [
  { href: `${home}#features`, label: 'Features' },
  { href: `${home}#how-it-works`, label: 'How it works' },
  { href: `${home}#download`, label: 'Download' },
  { href: `${home}#pricing`, label: 'Pricing' },
  { href: '/roadmap', label: 'Roadmap' },
  { href: '/blog/', label: 'Blog' },
];
const support = [
  { href: `${home}#contact`, label: 'Contact us' },
  { href: '/privacy', label: 'Privacy policy' },
];
const linkClass = 'text-on-night hover:text-white underline-offset-4 hover:underline rounded focus-visible:outline-3 focus-visible:outline-white focus-visible:outline-offset-2';
---

<footer class="ch-on-night bg-night text-on-night">
  <div class="ch-container py-12 grid gap-10 sm:grid-cols-[2fr_1fr_1fr]">
    <div>
      <div class="flex items-center gap-3 mb-4">
        <img src="/images/chimes-logo-192.webp" alt="" width="192" height="192" loading="lazy" class="h-12 w-12" />
        <span class="font-display font-bold text-white text-[28px] leading-none">Chimes</span>
      </div>
      <p class="font-display text-xl font-semibold text-white mb-2">The ice cream app.</p>
      <p class="max-w-xs">Know when the van's in your area. Put your van where your customers can see it.</p>
    </div>

    <nav aria-label="Product" class="flex flex-col gap-2">
      <p class="text-xs font-bold uppercase tracking-[1px] text-white mb-1">Product</p>
      {product.map((l) => <a href={l.href} class={linkClass}>{l.label}</a>)}
    </nav>

    <nav aria-label="Support" class="flex flex-col gap-2">
      <p class="text-xs font-bold uppercase tracking-[1px] text-white mb-1">Support</p>
      {support.map((l) => <a href={l.href} class={linkClass}>{l.label}</a>)}
      <a href="mailto:chimesapp@just-iot.com" class={linkClass}>chimesapp@just-iot.com</a>
    </nav>
  </div>

  <div class="border-t border-white/10">
    <div class="ch-container py-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-sm">
      <p>© 2025 Chimes. All rights reserved.</p>
      <div class="flex gap-2">
        <a href="https://www.facebook.com/chimesapp" target="_blank" rel="noopener noreferrer" class="grid place-items-center w-11 h-11 rounded-full text-on-night hover:text-white hover:bg-white/10 focus-visible:outline-3 focus-visible:outline-white" aria-label="Chimes on Facebook">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" class="fill-current" aria-hidden="true">
            <path d="M9 8h-3v4h3v12h5v-12h3.642l.358-4h-4v-1.667c0-.955.192-1.333 1.115-1.333h2.885v-5h-3.808c-3.596 0-5.192 1.583-5.192 4.615v3.385z"/>
          </svg>
        </a>
        <a href="https://instagram.com/chimesapp" target="_blank" rel="noopener noreferrer" class="grid place-items-center w-11 h-11 rounded-full text-on-night hover:text-white hover:bg-white/10 focus-visible:outline-3 focus-visible:outline-white" aria-label="Chimes on Instagram">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="2" y="2" width="20" height="20" rx="5" ry="5" /><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" /><line x1="17.5" y1="6.5" x2="17.51" y2="6.5" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</footer>
